# ========================================================
# InterviewAce Environment Configuration
# ========================================================

# 1. Standalone Backend Server Configuration
PORT=5000
JWT_SECRET=interviewace_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
DB_PATH=./data/interviewace.sqlite

# 2. Server-side AI Provider Configuration (Google Gemini / Generative AI)
# Keep these private on the backend (DO NOT prefix with VITE_)
AI_PROVIDER_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/

# 3. Frontend API Base URL (Defaults to /api via Vite reverse proxy)
VITE_API_URL=/api

# 4. Optional: Supabase Client Configuration
# If configured, provides secondary sync. If left blank, the built-in
# Node.js + SQLite backend powers all auth, sessions, questions, and analytics.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
